      "key": "username",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "okCard",
      "value": ""
    },
    {
      "key": "declinedCard",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "cartTotal",
      "value": ""
    },
    {
      "key": "expectedTotal",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Магазин и каталог",
      "item": [
        {
          "name": "Здоровье магазина",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const h = pm.response.json();",
                  "pm.test(\"Магазин отвечает ok\", () => pm.expect(h.status).to.eql(\"ok\"));",
                  "pm.test(\"Версия магазина в виде 3.N.0\", () => pm.expect(h.version).to.match(/^3\\.\\d+\\.0$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "Тестовые карты",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const cards = pm.response.json().cards;",
                  "const ok = cards.find((c) => c.outcome === \"succeeded\");",
                  "const declined = cards.find((c) => c.outcome === \"card_declined\");",
                  "pm.test(\"Есть карта, которая проходит, и карта, которую отклоняют\", () => {",
                  "  pm.expect(ok, \"карта с outcome succeeded\").to.be.an(\"object\");",
                  "  pm.expect(declined, \"карта с outcome card_declined\").to.be.an(\"object\");",
                  "});",
                  "pm.collectionVariables.set(\"okCard\", ok.number);",
                  "pm.collectionVariables.set(\"declinedCard\", declined.number);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/test-cards",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test-cards"
              ]
            }
          }
        },
        {
          "name": "Категории",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const cats = pm.response.json();",
                  "pm.test(\"Пять категорий\", () => pm.expect(cats.map((c) => c.slug)).to.have.members([\"kettles\", \"bikes\", \"books\", \"lamps\", \"backpacks\"]));",
                  "pm.test(\"Всего 37 товаров\", () => pm.expect(cats.reduce((n, c) => n + c.count, 0)).to.eql(37));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            }
          }
        },
        {
          "name": "Чайники, сначала дешевые",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Девять чайников\", () => pm.expect(page.total).to.eql(9));",
                  "pm.test(\"Только чайники, цены в рублях\", () => page.items.forEach((p) => {",
                  "  pm.expect(p.category).to.eql(\"kettles\");",
                  "  pm.expect(p.currency).to.eql(\"RUB\");",
                  "}));",
                  "pm.test(\"По возрастанию цены\", () => {",
                  "  const prices = page.items.map((p) => p.price);",
                  "  pm.expect(prices).to.eql([...prices].sort((a, b) => a - b));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?category=kettles&sort=price_asc&page_size=48",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "kettles"
                },
                {
                  "key": "sort",
                  "value": "price_asc"
                },
                {
                  "key": "page_size",
                  "value": "48"
                }
              ]
            }
          }
        },
        {
          "name": "Один товар",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test(\"Это чайник Hearthline Classic\", () => {",
                  "  pm.expect(p.sku).to.eql(\"KT-1001\");",
                  "  pm.expect(p.name).to.eql(\"Чайник Hearthline Classic 1,7 л\");",
                  "});",
                  "pm.test(\"Цена 4900 рублей\", () => {",
                  "  pm.expect(p.price).to.eql(4900);",
                  "  pm.expect(p.currency).to.eql(\"RUB\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": [
                "{{baseUrl}}"
