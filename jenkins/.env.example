# Скопируйте в .env рядом с docker-compose.yml. Файл .env в git не попадает.

# Вход в ваш учебный Jenkins. Пароль придумайте сами, он живет только в .env.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=

# Порт Jenkins на вашей машине.
JENKINS_PORT=8090

# Только Linux: группа сокета Docker – stat -c %g /var/run/docker.sock
# Docker Desktop (Windows, macOS): оставьте 0.
DOCKER_GID=0

# Откуда задачи берут Jenkinsfile: репозиторий polka-ci по метке course-v1.
POLKA_REPO_URL=https://github.com/artichokeee/polka-ci.git
POLKA_REF=course-v1

# Образ магазина (запасное зеркало: registry.qasandbox.org/polka-shop).
POLKA_IMAGE=ghcr.io/artichokeee/polka-shop
