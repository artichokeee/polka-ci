        },
        {
          "name": "Товара нет",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 404\", () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test(\"Код ошибки product_not_found\", () => pm.expect(body.error.code).to.eql(\"product_not_found\"));",
                  "pm.test(\"В ошибке есть trace id\", () => pm.expect(body.trace_id).to.eql(pm.response.headers.get(\"x-trace-id\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "999999"
              ]
            }
          }
        }
      ]
