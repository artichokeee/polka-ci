          "name": "Просроченный купон WINTER10",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Код ошибки coupon_expired\", () => pm.expect(pm.response.json().error.code).to.eql(\"coupon_expired\"));"
                ]
