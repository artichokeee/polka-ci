    {
      "name": "Корзина и заказ",
      "item": [
        {
          "name": "Два чайника в корзину",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "const cart = pm.response.json();",
                  "pm.test(\"Подытог 9800 рублей\", () => pm.expect(cart.subtotal).to.eql(9800));",
                  "pm.test(\"Доставка бесплатная от 5000 рублей\", () => pm.expect(cart.shipping).to.eql(0));",
                  "pm.test(\"Итого 9800 рублей\", () => pm.expect(cart.total).to.eql(9800));",
                  "pm.test(\"Валюта корзины – рубли\", () => pm.expect(cart.currency).to.eql(\"RUB\"));",
                  "pm.collectionVariables.set(\"cartTotal\", cart.total);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cart",
                "items"
              ]
            }
          }
        },
