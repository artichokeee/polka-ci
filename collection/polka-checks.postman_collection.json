            "url": {
              "raw": "{{baseUrl}}/api/cart/coupon",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cart",
                "coupon"
              ]
            }
          }
        },
        {
          "name": "Купон POLKA25",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Одна проверка на купон: если он не применился, заказ дальше идет по полной сумме корзины.",
                  "const res = pm.response.json();",
                  "const before = Number(pm.collectionVariables.get(\"cartTotal\"));",
                  "pm.collectionVariables.set(\"expectedTotal\", pm.response.code === 200 ? res.total : before);",
                  "pm.test(\"Купон POLKA25 дает скидку 25%\", () => {",
                  "  pm.expect(pm.response.code, res.error ? res.error.message : \"\").to.eql(200);",
                  "  pm.expect(res.discount).to.eql(Math.round(res.subtotal * 0.25));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"POLKA25\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/coupon",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cart",
                "coupon"
              ]
            }
          }
        },
        {
          "name": "Оформить заказ",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.test(\"Ждет оплаты\", () => pm.expect(order.status).to.eql(\"awaiting_payment\"));",
                  "pm.test(\"Номер заказа вида SH-100042\", () => pm.expect(order.number).to.match(/^SH-\\d{6}$/));",
                  "pm.test(\"Сумма заказа равна сумме корзины\", () => pm.expect(order.total).to.eql(Number(pm.collectionVariables.get(\"expectedTotal\"))));",
                  "pm.collectionVariables.set(\"orderId\", order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
